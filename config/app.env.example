# Combined project settings. Copy to config/app.env (Make and Compose read that file).
# Backend Settings also load config/app.env, then an optional root .env, then the process environment.
# Default tests stay hermetic under pytest. EMBEDDING_PROVIDER=lexical and
# COMPLETION_PROVIDER=extractive keep the demo offline.
# Set EMBEDDING_PROVIDER=ollama to use nomic-embed-text via local Ollama (make run) or Compose Ollama.
# Set COMPLETION_PROVIDER=ollama to answer with OLLAMA_CHAT_MODEL via local Ollama.
# make run / make run-docker pull whichever models those providers require when missing.

# --- Database ---
# make run uses your local Postgres (no Docker). Prefer DATABASE_URL, or the DATABASE_* parts.
# Example for a local server on 5432 (adjust user/password/db):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
#
# Compose (make run-docker) publishes Postgres on POSTGRES_HOST_PORT (default 5433)
# so a local server on 5432 can stay running.
POSTGRES_USER=codebase
POSTGRES_PASSWORD=codebase
POSTGRES_DB=codebase
POSTGRES_HOST_PORT=5433
# Host Make path: point at your own Postgres. Compose path often uses 5433:
DATABASE_URL=postgresql+psycopg://codebase:codebase@localhost:5433/codebase

# API (host-side Make/manual). Compose maps API_PORT to container port 8000.
API_HOST=127.0.0.1
API_PORT=8000
CORS_ALLOW_ORIGIN=http://localhost:3000

# Frontend (browser talks to the published API port, not the Docker service name)
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000

# Ollama — make run talks to OLLAMA_HOST on the machine. Compose publishes OLLAMA_HOST_PORT;
# the backend container uses http://ollama:11434.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_HOST_PORT=11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_EMBED_BATCH_SIZE=16
EMBEDDING_PROVIDER=lexical
COMPLETION_PROVIDER=extractive
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_RETRIES=2
MAX_QUESTION_CHARS=2000
MAX_CONTEXT_CHARS=12000
MAX_EXCERPT_CHARS=2000

# Ingestion — ZIP admission and member limits
MAX_ARCHIVE_BYTES=10485760
MAX_ARCHIVE_FILE_COUNT=500
MAX_ARCHIVE_FILE_BYTES=1048576
MAX_ARCHIVE_EXTRACTED_BYTES=20971520
MAX_ARCHIVE_COMPRESSION_RATIO=100
