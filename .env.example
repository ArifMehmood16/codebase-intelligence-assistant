# Optional overlay. Combined settings live in config/app.env.example.
# make setup copies that file to config/app.env.
# For make run (no Docker), set DATABASE_URL or DATABASE_USER/DATABASE_NAME
# (and optionally DATABASE_PASSWORD/HOST/PORT) to your local Postgres.
# Set EMBEDDING_PROVIDER=ollama only when a local Ollama process is running.
# Compose interpolation can also use --env-file config/app.env without this file.
